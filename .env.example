# Load these into your process environment; Agbredo does not parse dotenv files.
# All are required, except the port.
AGBREDO_DATABASE_URL=postgres://agbredo:agbredo-local@localhost:5432/agbredo?sslmode=disable
# Public origin, used for the OAuth callback. Cookies are Secure when it is https.
AGBREDO_BASE_URL=http://localhost:8080
# Railway sets PORT, which wins over AGBREDO_PORT. Default 8080.
AGBREDO_PORT=8080

# From the Agbredo GitHub App.
AGBREDO_GITHUB_CLIENT_ID=
AGBREDO_GITHUB_CLIENT_SECRET=
# The GitHub App webhook secret.
AGBREDO_GITHUB_WEBHOOK_SECRET=

# At least 32 characters. Generate: openssl rand -hex 32
AGBREDO_SESSION_KEY=
# Comma-separated GitHub logins allowed to see the dashboard.
AGBREDO_USERS=your-github-login
