# Load these into your process environment; Rilian does not parse dotenv files.
RILIAN_DATABASE_URL=postgres://rilian:rilian-local@localhost:5432/rilian?sslmode=disable
# Exact public origin used by OAuth and as the GitHub OIDC audience. No trailing /.
# Use an HTTPS tunnel for local GitHub Actions/webhook testing.
RILIAN_BASE_URL=http://localhost:8080
RILIAN_PORT=8080
# Railway PORT takes precedence over RILIAN_PORT.
# PORT=8080

RILIAN_GITHUB_APP_ID=
RILIAN_GITHUB_CLIENT_ID=
RILIAN_GITHUB_CLIENT_SECRET=
# At least 32 random characters, matching the GitHub App webhook secret.
RILIAN_GITHUB_WEBHOOK_SECRET=
# Choose exactly one private key source. Never commit a PEM file.
RILIAN_GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/rilian.private-key.pem
# Railway: set RILIAN_GITHUB_PRIVATE_KEY to the complete PEM with real newlines.
# RILIAN_GITHUB_PRIVATE_KEY=

# Generate: openssl rand -hex 32
RILIAN_SESSION_KEY=
# GitHub login names; only these users can use the dashboard or decide approvals.
RILIAN_ADMIN_USERS=your-github-login
# Go duration from 1m to 168h. Expired approvals cannot execute, even if approved earlier.
RILIAN_APPROVAL_TTL=24h

# Optional, separate disposable database for persistence integration tests.
# Tests skip database integration when this variable is absent.
# RILIAN_TEST_DATABASE_URL=postgres://rilian:rilian-local@localhost:5432/rilian_test?sslmode=disable
