# Load these into your process environment; Agbredo does not parse dotenv files.
# Claude Code executes in existing GitHub Actions workflows. Keep its
# CLAUDE_CODE_OAUTH_TOKEN in Actions secrets, never in this Go process environment.
AGBREDO_DATABASE_URL=postgres://agbredo:agbredo-local@localhost:5432/agbredo?sslmode=disable
# Exact public origin used by OAuth and as the GitHub OIDC audience. No trailing /.
# Use an HTTPS tunnel for local GitHub Actions/webhook testing.
AGBREDO_BASE_URL=http://localhost:8080
AGBREDO_PORT=8080
# Railway PORT takes precedence over AGBREDO_PORT.
# PORT=8080

AGBREDO_GITHUB_APP_ID=
AGBREDO_GITHUB_CLIENT_ID=
AGBREDO_GITHUB_CLIENT_SECRET=
# At least 32 random characters, matching the GitHub App webhook secret.
AGBREDO_GITHUB_WEBHOOK_SECRET=
# Choose exactly one private key source. Never commit a PEM file.
AGBREDO_GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/agbredo.private-key.pem
# Railway: set AGBREDO_GITHUB_PRIVATE_KEY to the complete PEM with real newlines.
# AGBREDO_GITHUB_PRIVATE_KEY=

# Generate: openssl rand -hex 32
AGBREDO_SESSION_KEY=
# GitHub login names; only these users can use the dashboard.
AGBREDO_USERS=your-github-login

# Optional: per-run estimate threshold, in dollars, of a deployment created by
# its first run. 5 when unset. Each deployment's threshold is edited on its page.
# AGBREDO_DEFAULT_THRESHOLD_USD=5

# Optional, separate disposable database for persistence integration tests.
# Tests skip database integration when this variable is absent.
# AGBREDO_TEST_DATABASE_URL=postgres://agbredo:agbredo-local@localhost:5432/agbredo_test?sslmode=disable
